{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendrum.invalid/ops/inspect.request.schema.json",
  "title": "The request of inspect",
  "type": "object",
  "properties": {
    "ics": {
      "type": "string",
      "description": "The calendar as text."
    },
    "ics_base64": {
      "type": "string",
      "description": "The calendar as bytes in base64, in any encoding the library detects."
    },
    "include_jcal": {
      "type": "boolean"
    },
    "limit": {
      "$ref": "common.schema.json#/$defs/limit"
    }
  }
}
