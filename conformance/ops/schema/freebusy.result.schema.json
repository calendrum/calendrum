{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendrum.invalid/ops/freebusy.result.schema.json",
  "title": "The result of freebusy",
  "type": "object",
  "properties": {
    "busy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "common.schema.json#/$defs/moment"
          },
          "end": {
            "$ref": "common.schema.json#/$defs/moment"
          },
          "type": {
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "start",
          "end",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "common.schema.json#/$defs/moment"
          },
          "end": {
            "$ref": "common.schema.json#/$defs/moment"
          },
          "first": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "x-untrusted": true
              },
              "summary": {
                "type": "string",
                "x-untrusted": true
              },
              "start": {
                "$ref": "common.schema.json#/$defs/moment"
              },
              "end": {
                "$ref": "common.schema.json#/$defs/moment"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "second": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "x-untrusted": true
              },
              "summary": {
                "type": "string",
                "x-untrusted": true
              },
              "start": {
                "$ref": "common.schema.json#/$defs/moment"
              },
              "end": {
                "$ref": "common.schema.json#/$defs/moment"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "start",
          "end",
          "first",
          "second"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "$ref": "common.schema.json#/$defs/problems"
    },
    "problem_count": {
      "type": "integer",
      "description": "The problems found, also the ones beyond the list. Past 1000 the parser stops reporting them, and the result is truncated."
    }
  },
  "required": [
    "busy",
    "conflicts",
    "problems",
    "problem_count"
  ],
  "additionalProperties": false
}
