{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendrum.invalid/ops/build_event.result.schema.json",
  "title": "The result of build_event",
  "type": "object",
  "properties": {
    "uid": {
      "type": "string",
      "x-untrusted": true
    },
    "ics": {
      "type": "string",
      "x-untrusted": true
    },
    "problems": {
      "$ref": "common.schema.json#/$defs/problems"
    },
    "problem_count": {
      "type": "integer",
      "description": "The problems found, also the ones beyond the list. Past 1000 the parser stops reporting them, and the result is truncated."
    }
  },
  "required": [
    "uid",
    "ics",
    "problems",
    "problem_count"
  ],
  "additionalProperties": false
}
