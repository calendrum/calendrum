{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendrum.invalid/ops/diff.result.schema.json",
  "title": "The result of diff",
  "type": "object",
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calendar_index": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "x-untrusted": true
          },
          "uid": {
            "type": "string",
            "x-untrusted": true
          },
          "recurrence_id": {
            "type": "string",
            "x-untrusted": true
          },
          "tzid": {
            "type": "string",
            "x-untrusted": true
          },
          "ordinal": {
            "type": "integer"
          }
        },
        "required": [
          "calendar_index",
          "name",
          "ordinal"
        ],
        "additionalProperties": false
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calendar_index": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "x-untrusted": true
          },
          "uid": {
            "type": "string",
            "x-untrusted": true
          },
          "recurrence_id": {
            "type": "string",
            "x-untrusted": true
          },
          "tzid": {
            "type": "string",
            "x-untrusted": true
          },
          "ordinal": {
            "type": "integer"
          }
        },
        "required": [
          "calendar_index",
          "name",
          "ordinal"
        ],
        "additionalProperties": false
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calendar_index": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "x-untrusted": true
          },
          "uid": {
            "type": "string",
            "x-untrusted": true
          },
          "recurrence_id": {
            "type": "string",
            "x-untrusted": true
          },
          "tzid": {
            "type": "string",
            "x-untrusted": true
          },
          "ordinal": {
            "type": "integer"
          }
        },
        "required": [
          "calendar_index",
          "name",
          "ordinal"
        ],
        "additionalProperties": false
      }
    },
    "unchanged_count": {
      "type": "integer"
    },
    "problems": {
      "$ref": "common.schema.json#/$defs/problems"
    },
    "problem_count": {
      "type": "integer",
      "description": "The problems found, also the ones beyond the list. Past 1000 the parser stops reporting them, and the result is truncated."
    }
  },
  "required": [
    "added",
    "removed",
    "changed",
    "unchanged_count",
    "problems",
    "problem_count"
  ],
  "additionalProperties": false
}
