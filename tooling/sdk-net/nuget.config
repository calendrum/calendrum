<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- A push without a source stays on this machine: nothing goes to a public feed by accident. -->
    <add key="defaultPushSource" value="build/local-feed" />
  </config>
</configuration>
